---
const title = 'Verify HuddleWay Email';
const description = 'Browser fallback for HuddleWay email verification links.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" sizes="any" type="image/png" />
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f7fb;
        --surface: #ffffff;
        --ink: #171f2e;
        --muted: #667085;
        --brand: #1167f2;
        --brand-deep: #0d46c6;
        --line: rgba(23, 31, 46, 0.12);
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Sora, Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--ink);
        background: linear-gradient(180deg, #eef4ff 0%, var(--bg) 100%);
      }

      main {
        width: min(880px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 72px 0;
      }

      .panel {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 24px 60px rgba(23, 31, 46, 0.1);
        padding: clamp(28px, 5vw, 48px);
      }

      .eyebrow {
        margin: 0 0 12px;
        color: var(--brand-deep);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.1rem, 7vw, 4.3rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      p {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.65;
      }

      .lede {
        max-width: 680px;
        margin: 18px 0 0;
        font-size: 1.12rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 18px;
        border-radius: 12px;
        background: var(--brand);
        color: #ffffff;
        font-weight: 800;
      }

      .button.secondary {
        background: #e8eef8;
        color: var(--ink);
      }

      .context {
        margin-top: 28px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #f8fbff;
        padding: 18px;
      }

      .context p {
        margin: 0;
        overflow-wrap: anywhere;
      }
    </style>
    <script>
      (function () {
        var params = new URLSearchParams(window.location.search);
        if (!params.toString()) return;
        window.location.href = 'huddleway:///account/verify?' + params.toString();
      })();
    </script>
  </head>
  <body>
    <main>
      <section class="panel">
        <p class="eyebrow">HuddleWay Hub</p>
        <h1>Open the app to verify your email</h1>
        <p class="lede">
          Email verification is a protected app workflow. If the app did not
          open automatically, use the button below from your mobile device.
        </p>

        <div class="actions">
          <a class="button" id="open-app" href="huddleway:///account/verify">Open HuddleWay Hub</a>
          <a class="button secondary" href="/support/">Support</a>
        </div>

        <div class="context" aria-live="polite">
          <p id="context-line">Checking verification details...</p>
        </div>
      </section>
    </main>

    <script>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var tenant = (params.get('tenant') || '').trim();
        var hasToken = (params.get('token') || '').trim().length > 0;

        var appUrl = 'huddleway:///account/verify';
        if (params.toString()) appUrl += '?' + params.toString();

        var openApp = document.getElementById('open-app');
        var contextLine = document.getElementById('context-line');
        if (openApp) openApp.setAttribute('href', appUrl);
        if (contextLine) {
          contextLine.textContent = tenant || hasToken
            ? 'Verification details detected' + (tenant ? ' for tenant=' + tenant : '') + '.'
            : 'No verification details were included in this link.';
        }
      })();
    </script>
  </body>
</html>
