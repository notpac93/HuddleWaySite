---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'HuddleWay Support';
const description = 'Support information for HuddleWay.';
---

<BaseLayout title={title} description={description} pageName="support">
  <section class="legal-page">
    <div class="legal-page__inner">
      <p class="legal-page__eyebrow">Support</p>
      <h1>HuddleWay Support</h1>
      <p class="legal-page__updated">Last updated: May 20, 2026</p>
      <p class="legal-page__lede">
        For support, privacy questions, account issues, or App Review follow-up,
        use the contact details below.
      </p>

      <div class="legal-card">
        <h2>Submit a Support Request</h2>
        <p style="margin-bottom: 1.5rem;">
          If your question is about a specific sports program, event,
          registration, or refund decision, contact that program operator first.
          For platform support, account issues, privacy questions, or App Review follow-up, fill out the form below.
        </p>

        <!-- REPLACE 'YOUR_FORM_ID' WITH YOUR ACTUAL FORMSPREE ID -->
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="support-form">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Your Name" />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="your.email@example.com" />
          </div>

          <div class="form-group">
            <label for="issue_type">Issue Type</label>
            <select id="issue_type" name="issue_type" required>
              <option value="">Select an issue type...</option>
              <option value="Account Access">Account-access issues</option>
              <option value="Platform Support">Platform support questions</option>
              <option value="Privacy / Deletion">Privacy-policy or Deletion-request</option>
              <option value="App Review">App Review support</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="Describe your issue in detail..."></textarea>
          </div>

          <button type="submit" class="submit-btn">Submit Request</button>
        </form>
      </div>

      <style>
        .support-form {
          display: flex;
          flex-direction: column;
          gap: 1.25rem;
          margin-top: 1rem;
        }
        .form-group {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }
        .form-group label {
          font-weight: 600;
          font-size: 0.95rem;
          color: #1f3b63;
        }
        .form-group input, .form-group select, .form-group textarea {
          padding: 0.75rem;
          border: 1px solid #d9dee7;
          border-radius: 6px;
          font-family: inherit;
          font-size: 1rem;
          background: #fff;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
          outline: none;
          border-color: #1f3b63;
          box-shadow: 0 0 0 2px rgba(31, 59, 99, 0.1);
        }
        .submit-btn {
          background-color: #1f3b63;
          color: white;
          border: none;
          padding: 0.85rem 1.5rem;
          font-size: 1rem;
          font-weight: 600;
          border-radius: 6px;
          cursor: pointer;
          align-self: flex-start;
          transition: background-color 0.2s ease;
        }
        .submit-btn:hover {
          background-color: #152945;
        }
      </style>
    </div>
  </section>
</BaseLayout>
