---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'HuddleWay Terms of Use';
const description = 'Terms of Use for HuddleWay Hub and HuddleWay Admin.';
---

<BaseLayout title={title} description={description} pageName="terms-of-use">
  <section class="legal-page">
    <div class="legal-page__inner">
      <p class="legal-page__eyebrow">Legal</p>
      <h1>Terms of Use</h1>
      <p class="legal-page__updated">Last updated: May 20, 2026</p>
      <p class="legal-page__lede">
        These Terms of Use apply to HuddleWay Hub, HuddleWay Admin, and the
        related web links and backend services used with them.
      </p>

      <div class="legal-card">
        <h2>Service Scope</h2>
        <p>
          HuddleWay provides family-facing and operator-facing tools for sports
          programs and similar organizations, including schedules, registration,
          payments, messaging, documents, and branded program information.
        </p>

        <h2>Accounts And Access</h2>
        <p>
          Users must provide accurate account information and protect their
          credentials. Program operators are responsible for controlling admin
          access inside their organization.
        </p>

        <h2>Acceptable Use</h2>
        <ul>
          <li>Do not use the service for unlawful, abusive, fraudulent, or infringing activity.</li>
          <li>Do not upload or send content you do not have the right to share.</li>
          <li>Do not interfere with the service, another tenant, or another user's access.</li>
          <li>Do not impersonate another person, program, or organization.</li>
        </ul>

        <h2>Operator Responsibilities</h2>
        <ul>
          <li>Keep program information, payment details, and communications accurate.</li>
          <li>Handle participant and family data responsibly.</li>
          <li>Respond to moderation, refund, deletion, and support issues for your program.</li>
          <li>Make sure uploaded documents, photos, logos, and other content are authorized for use.</li>
        </ul>

        <h2>Messages, Uploads, And Content</h2>
        <p>
          Users remain responsible for the content they publish, upload, or send
          through HuddleWay. We may restrict or remove content that violates
          these terms, tenant rules, or platform safety requirements.
        </p>

        <h2>Payments And Refunds</h2>
        <p>
          Some tenants may use HuddleWay to collect payment for eligible
          real-world or off-app services. Stripe may process those payments
          where enabled. Refund and registration decisions remain the
          responsibility of the tenant operator unless HuddleWay explicitly
          states otherwise.
        </p>
        <p>
          In iOS App Store contexts, HuddleWay does not intend Stripe to be used
          for digital unlocks or in-app digital subscriptions in this release.
        </p>

        <h2>Links, Invites, And QR Entry</h2>
        <p>
          HuddleWay may provide invite links, QR join links, registration links,
          and password reset links. These may expire or stop working if the
          linked record is removed, disabled, or no longer public.
        </p>

        <h2>Termination Or Restriction</h2>
        <p>
          HuddleWay may suspend, limit, or remove access when needed to protect
          users, tenant data, platform operations, or legal compliance.
        </p>

        <h2>Changes To The Service</h2>
        <p>
          We may update the service, related workflows, and these terms over
          time. Continued use after an update means the user accepts the revised
          terms.
        </p>

        <h2>Contact</h2>
        <p>
          For support or terms questions, contact:
          <a href="mailto:support@huddleway.com">support@huddleway.com</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
