---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import { appStorePrompt, navigation, primaryCta, siteMeta, trustLinks } from '../data/site';

interface Props {
  title: string;
  description: string;
  pageName?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, pageName = 'default', structuredData } = Astro.props;
const pathname = Astro.url.pathname;
const toStaticFile = (value: string) => {
  const [pathOnly] = value.split('#');

  if (pathOnly === '' || pathOnly === '/') {
    return 'index.html';
  }

  if (pathOnly.endsWith('.html')) {
    return pathOnly.replace(/^\//, '');
  }

  return `${pathOnly.replace(/^\/+|\/+$/g, '')}.html`;
};

const homeHref = navigation[0]?.href ?? 'index.html';
const currentFile = toStaticFile(pathname);
const siteUrl = Astro.site ?? new URL('https://huddleway.com');
const normalizedPathname = (() => {
  if (pathname === '/index.html' || pathname === '/') {
    return '/';
  }

  const withoutIndex = pathname.replace(/\/index\.html$/, '/');
  const withoutHtml = withoutIndex.replace(/\.html$/, '');
  const withoutTrailingSlash = withoutHtml !== '/' ? withoutHtml.replace(/\/$/, '') : withoutHtml;

  return withoutTrailingSlash || '/';
})();
const canonicalUrl = new URL(normalizedPathname, siteUrl).toString();
const schemaItems: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteMeta.name,
    url: siteUrl.toString(),
    description: siteMeta.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteMeta.name,
    url: siteUrl.toString(),
  },
];

if (structuredData) {
  schemaItems.push(...(Array.isArray(structuredData) ? structuredData : [structuredData]));
}

const escapeJsonLd = (value: string) =>
  value
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');

const schemaScripts = schemaItems.map((item) => {
  const json = escapeJsonLd(JSON.stringify(item));
  const hash = createHash('sha256').update(json).digest('base64');

  return {
    json,
    hash: `'sha256-${hash}'`,
  };
});

const cspDirectives = [
  "default-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  `script-src 'self' ${schemaScripts.map((item) => item.hash).join(' ')}`,
  "connect-src 'self'",
  "frame-src 'none'",
  "object-src 'none'",
  "worker-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={cspDirectives} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" sizes="any" type="image/png" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schemaScripts.map((item) => (
      <script is:inline type="application/ld+json" set:html={item.json} />
    ))}
  </head>
  <body class={`page page--${pageName}`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand" href={homeHref}>
            <span class="brand__mark" aria-hidden="true"><img src="/logo-mark.png" alt="" /></span>
            <span class="brand__text">{siteMeta.name}</span>
          </a>

          <nav class="site-nav" aria-label="Primary">
            {navigation.map((item) => {
              const active = toStaticFile(item.href) === currentFile;

              return (
                <a class={`site-nav__link ${active ? 'is-active' : ''}`} href={item.href} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })}
          </nav>

          {primaryCta.prompt === 'app-store-choice' ? (
            <a class="button button--primary site-header__cta" href={primaryCta.href} data-app-store-choice="true" aria-haspopup="dialog">{primaryCta.label}</a>
          ) : (
            <a class="button button--primary site-header__cta" href={primaryCta.href}>{primaryCta.label}</a>
          )}
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <dialog class="app-store-dialog" data-app-store-dialog aria-labelledby="app-store-dialog-title">
        <div class="app-store-dialog__panel">
          <button class="app-store-dialog__close" type="button" data-app-store-dialog-close aria-label="Close download chooser">
            <span aria-hidden="true">×</span>
          </button>
          <p class="section-intro__eyebrow">Download HuddleWay</p>
          <h2 id="app-store-dialog-title">{appStorePrompt.title}</h2>
          <p class="app-store-dialog__body">{appStorePrompt.body}</p>

          <div class="app-store-dialog__actions">
            <a class="button button--primary button--full" href={appStorePrompt.admin.href} target="_blank" rel="noreferrer">
              {appStorePrompt.admin.label}
            </a>
            <p class="app-store-dialog__note">{appStorePrompt.admin.note}</p>

            {appStorePrompt.family.href ? (
              <>
                <a class="button button--secondary button--full" href={appStorePrompt.family.href} target="_blank" rel="noreferrer">
                  {appStorePrompt.family.label}
                </a>
                <p class="app-store-dialog__note">{appStorePrompt.family.note}</p>
              </>
            ) : (
              <>
                <button class="button button--secondary button--full app-store-dialog__button-disabled" type="button" disabled>
                  {appStorePrompt.family.label}
                </button>
                <p class="app-store-dialog__note">{appStorePrompt.family.note}</p>
              </>
            )}
          </div>

          <button class="app-store-dialog__dismiss" type="button" data-app-store-dialog-close>
            {appStorePrompt.dismissLabel}
          </button>
        </div>
      </dialog>

      <footer class="site-footer">
        <div class="site-footer__grid">
          <div>
            <a class="brand brand--footer" href={homeHref}>
              <span class="brand__mark" aria-hidden="true"><img src="/logo-mark.png" alt="" /></span>
              <span class="brand__text">{siteMeta.name}</span>
            </a>
            <p class="site-footer__blurb">{siteMeta.footerBlurb}</p>
          </div>

          <div>
            <h2 class="site-footer__heading">Pages</h2>
            <ul class="site-footer__list">
              {navigation.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="site-footer__heading">Support & Legal</h2>
            <ul class="site-footer__list">
              {trustLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="site-footer__heading">Get Started</h2>
            <p class="site-footer__note">Choose Administrator or Family, then head to the App Store download that fits your role.</p>
            {primaryCta.prompt === 'app-store-choice' ? (
              <a class="button button--primary button--full" href={primaryCta.href} data-app-store-choice="true" aria-haspopup="dialog">{primaryCta.label}</a>
            ) : (
              <a class="button button--primary button--full" href={primaryCta.href}>{primaryCta.label}</a>
            )}
          </div>
        </div>
      </footer>
    </div>
    <script is:inline src="/scripts/app-store-choice.js"></script>
  </body>
</html>
