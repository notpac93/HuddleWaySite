---
import '../styles/crm.css';
import {
  publicEnvironment,
  resolveBackendUrl,
  resolveCrmAppPreviewUrl,
} from '../lib/config/publicEnvironment';

interface Props {
  title: string;
}

const { title } = Astro.props;
const backendOrigin = new URL(resolveBackendUrl(publicEnvironment)).origin;
const firebaseAuthDomain =
  String(publicEnvironment.PUBLIC_FIREBASE_AUTH_DOMAIN || '').trim()
  || (import.meta.env.PROD
    ? 'sports-team-apps.firebaseapp.com'
    : 'huddleway-dev.firebaseapp.com');
const firebaseAuthOrigin = new URL(
  `https://${firebaseAuthDomain}`,
).origin;
const appPreviewOrigin = resolveCrmAppPreviewUrl(publicEnvironment);
const developmentConnectSources = import.meta.env.DEV
  ? [
      'http://localhost:*',
      'http://127.0.0.1:*',
      'ws://localhost:*',
      'ws://127.0.0.1:*',
    ]
  : [];
const cspDirectives = [
  "default-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
  "font-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  [
    "script-src 'self' 'unsafe-inline'",
    'https://www.google.com/recaptcha/',
    'https://www.gstatic.com/recaptcha/',
  ].join(' '),
  [
    "connect-src 'self'",
    backendOrigin,
    firebaseAuthOrigin,
    'https://*.googleapis.com',
    'https://*.firebaseio.com',
    'wss://*.firebaseio.com',
    'https://www.google.com/recaptcha/',
    ...developmentConnectSources,
  ].join(' '),
  [
    "img-src 'self' data: blob: https:",
  ].join(' '),
  [
    "frame-src 'self'",
    firebaseAuthOrigin,
    ...(appPreviewOrigin ? [appPreviewOrigin] : []),
    'https://www.google.com/recaptcha/',
  ].join(' '),
  "worker-src 'self' blob:",
  ...(import.meta.env.PROD ? ['upgrade-insecure-requests'] : []),
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={cspDirectives} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <link rel="icon" href="/crm-favicon.png" sizes="64x64" type="image/png" />
    <meta name="robots" content="noindex, nofollow" /> <!-- CRM is private -->
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <slot />
  </body>
</html>
