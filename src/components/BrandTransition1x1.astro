---
const logos = [
  { src: '/fake-logo-1.png', alt: 'Summer Program' },
  { src: '/fake-logo-2.png', alt: 'Esports Team' },
  { src: '/fake-logo-3.png', alt: 'Track Team' }
];
---

<div class="brand-transition-1x1" aria-hidden="true">
  <div class="bt-1x1__container">
    <div class="bt-1x1__icon-wrapper">
      <!-- Source Logo -->
      <img src="/app-logo.png" alt="HuddleWay" class="bt-1x1__logo bt-1x1__logo--source" />
      
      <!-- Target Logos -->
      {logos.map((logo, index) => (
        <img src={logo.src} alt={logo.alt} class={`bt-1x1__logo bt-1x1__logo--target bt-1x1__logo--target-${index + 1}`} />
      ))}

      <!-- Dust Particles -->
      <div class="bt-1x1__dust-container">
        {Array.from({ length: 12 }).map((_, i) => (
          <div class={`bt-1x1__dust bt-1x1__dust--${i + 1}`}></div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .brand-transition-1x1 {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle at top left, rgba(17, 103, 242, 0.08), transparent 50%),
                radial-gradient(circle at bottom right, rgba(236, 106, 58, 0.08), transparent 50%),
                rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(23, 31, 46, 0.08);
    border-radius: 2rem;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(10, 28, 76, 0.06);
  }

  .bt-1x1__container {
    position: relative;
    width: 45%;
    aspect-ratio: 1 / 1;
    perspective: 1000px;
  }

  .bt-1x1__icon-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 22%;
    background: white;
    box-shadow: 0 15px 35px rgba(23, 31, 46, 0.15),
                inset 0 2px 4px rgba(255, 255, 255, 0.5);
    transform-style: preserve-3d;
    animation: bt-1x1-shake-cycle 9s infinite;
  }

  .bt-1x1__logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22%;
  }

  /* 
    Animation Timing (9s total, 3 cycles of 3s each):
    Cycle 1 (0-3s):
      0-1s: Source
      1-1.5s: Shake
      1.5-2.5s: Target 1
      2.5-3s: Fade back to Source
  */

  .bt-1x1__logo--source {
    animation: bt-1x1-source-fade 9s infinite;
  }

  .bt-1x1__logo--target-1 {
    opacity: 0;
    animation: bt-1x1-target-fade-1 9s infinite;
  }

  .bt-1x1__logo--target-2 {
    opacity: 0;
    animation: bt-1x1-target-fade-2 9s infinite;
  }

  .bt-1x1__logo--target-3 {
    opacity: 0;
    animation: bt-1x1-target-fade-3 9s infinite;
  }

  @keyframes bt-1x1-source-fade {
    0%, 15%, 30%, 48%, 63%, 81%, 96%, 100% { opacity: 1; }
    18%, 27%, 51%, 60%, 84%, 93% { opacity: 0; }
  }

  @keyframes bt-1x1-target-fade-1 {
    0%, 15% { opacity: 0; transform: scale(0.9); }
    18%, 27% { opacity: 1; transform: scale(1); }
    30%, 100% { opacity: 0; transform: scale(1.1); }
  }

  @keyframes bt-1x1-target-fade-2 {
    0%, 48% { opacity: 0; transform: scale(0.9); }
    51%, 60% { opacity: 1; transform: scale(1); }
    63%, 100% { opacity: 0; transform: scale(1.1); }
  }

  @keyframes bt-1x1-target-fade-3 {
    0%, 81% { opacity: 0; transform: scale(0.9); }
    84%, 93% { opacity: 1; transform: scale(1); }
    96%, 100% { opacity: 0; transform: scale(1.1); }
  }

  @keyframes bt-1x1-shake-cycle {
    0%, 10% { transform: rotate(0deg) scale(1); }
    12% { transform: rotate(-8deg) scale(1.05); }
    14% { transform: rotate(8deg) scale(1.05); }
    16% { transform: rotate(-5deg) scale(1.1); }
    18% { transform: rotate(0deg) scale(1.1); }
    22%, 27% { transform: rotate(0deg) scale(1.05); }
    30%, 43% { transform: rotate(0deg) scale(1); }
    
    45% { transform: rotate(-8deg) scale(1.05); }
    47% { transform: rotate(8deg) scale(1.05); }
    49% { transform: rotate(-5deg) scale(1.1); }
    51% { transform: rotate(0deg) scale(1.1); }
    55%, 60% { transform: rotate(0deg) scale(1.05); }
    63%, 76% { transform: rotate(0deg) scale(1); }

    78% { transform: rotate(-8deg) scale(1.05); }
    80% { transform: rotate(8deg) scale(1.05); }
    82% { transform: rotate(-5deg) scale(1.1); }
    84% { transform: rotate(0deg) scale(1.1); }
    88%, 93% { transform: rotate(0deg) scale(1.05); }
    96%, 100% { transform: rotate(0deg) scale(1); }
  }

  /* Dust Particles */
  .bt-1x1__dust-container {
    position: absolute;
    inset: -50%;
    pointer-events: none;
  }

  .bt-1x1__dust {
    position: absolute;
    width: 6px;
    height: 6px;
    background: #d0d7e5;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    opacity: 0;
  }

  /* Create 12 distinct dust particles with different trajectories */
  .bt-1x1__dust--1 { animation: bt-1x1-dust-1 9s infinite; }
  .bt-1x1__dust--2 { animation: bt-1x1-dust-2 9s infinite; }
  .bt-1x1__dust--3 { animation: bt-1x1-dust-3 9s infinite; }
  .bt-1x1__dust--4 { animation: bt-1x1-dust-4 9s infinite; }
  .bt-1x1__dust--5 { animation: bt-1x1-dust-5 9s infinite; }
  .bt-1x1__dust--6 { animation: bt-1x1-dust-6 9s infinite; }
  .bt-1x1__dust--7 { animation: bt-1x1-dust-7 9s infinite; }
  .bt-1x1__dust--8 { animation: bt-1x1-dust-8 9s infinite; }
  .bt-1x1__dust--9 { animation: bt-1x1-dust-9 9s infinite; }
  .bt-1x1__dust--10 { animation: bt-1x1-dust-10 9s infinite; }
  .bt-1x1__dust--11 { animation: bt-1x1-dust-11 9s infinite; }
  .bt-1x1__dust--12 { animation: bt-1x1-dust-12 9s infinite; }

  @keyframes bt-1x1-dust-1 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1); } 20%, 53%, 86% { opacity: 0; transform: translate(-40px, -60px) scale(0); } }
  @keyframes bt-1x1-dust-2 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.5); } 20%, 53%, 86% { opacity: 0; transform: translate(20px, -70px) scale(0); } }
  @keyframes bt-1x1-dust-3 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(0.8); } 20%, 53%, 86% { opacity: 0; transform: translate(50px, -40px) scale(0); } }
  @keyframes bt-1x1-dust-4 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.2); } 20%, 53%, 86% { opacity: 0; transform: translate(70px, 10px) scale(0); } }
  @keyframes bt-1x1-dust-5 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1); } 20%, 53%, 86% { opacity: 0; transform: translate(40px, 60px) scale(0); } }
  @keyframes bt-1x1-dust-6 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.5); } 20%, 53%, 86% { opacity: 0; transform: translate(-10px, 70px) scale(0); } }
  @keyframes bt-1x1-dust-7 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(0.8); } 20%, 53%, 86% { opacity: 0; transform: translate(-60px, 40px) scale(0); } }
  @keyframes bt-1x1-dust-8 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.2); } 20%, 53%, 86% { opacity: 0; transform: translate(-70px, -20px) scale(0); } }
  @keyframes bt-1x1-dust-9 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1); } 20%, 53%, 86% { opacity: 0; transform: translate(-20px, -50px) scale(0); } }
  @keyframes bt-1x1-dust-10 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.3); } 20%, 53%, 86% { opacity: 0; transform: translate(30px, 50px) scale(0); } }
  @keyframes bt-1x1-dust-11 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(0.9); } 20%, 53%, 86% { opacity: 0; transform: translate(50px, -20px) scale(0); } }
  @keyframes bt-1x1-dust-12 { 16%, 49%, 82% { opacity: 1; transform: translate(0, 0) scale(1.1); } 20%, 53%, 86% { opacity: 0; transform: translate(-50px, 20px) scale(0); } }

  @media (prefers-reduced-motion: reduce) {
    .bt-1x1__icon-wrapper,
    .bt-1x1__logo--source,
    .bt-1x1__logo--target-1,
    .bt-1x1__logo--target-2,
    .bt-1x1__logo--target-3,
    .bt-1x1__dust {
      animation: none !important;
    }
  }
</style>
