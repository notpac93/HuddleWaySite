---
const logos = [
  { src: '/fake-logo-1.png', alt: 'Summer Program' },
  { src: '/fake-logo-2.png', alt: 'Esports Team' },
  { src: '/fake-logo-3.png', alt: 'Track Team' }
];
---

<div class="brand-transition-1x1" aria-hidden="true">
  <div class="bt-1x1__container">
    <!-- Dust Particles (outside wrapper so they don't scale down) -->
    <div class="bt-1x1__dust-container">
      {Array.from({ length: 12 }).map((_, i) => (
        <div class={`bt-1x1__dust bt-1x1__dust--${i + 1}`}></div>
      ))}
    </div>

    <div class="bt-1x1__icon-wrapper">
      <!-- Source Logo -->
      <img src="/app-logo.png" alt="HuddleWay" class="bt-1x1__logo bt-1x1__logo--source" />
      
      <!-- Target Logos -->
      {logos.map((logo, index) => (
        <img src={logo.src} alt={logo.alt} class={`bt-1x1__logo bt-1x1__logo--target bt-1x1__logo--target-${index + 1}`} />
      ))}
    </div>
  </div>
</div>

<style>
  .brand-transition-1x1 {
    width: 100%;
    display: grid;
    place-items: center;
    position: relative;
    padding: 2rem 0;
  }

  .bt-1x1__container {
    position: relative;
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1 / 1;
    perspective: 1000px;
  }

  .bt-1x1__icon-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 22%;
    background: white;
    box-shadow: 0 15px 35px rgba(23, 31, 46, 0.15),
                inset 0 2px 4px rgba(255, 255, 255, 0.5);
    transform-style: preserve-3d;
    animation: bt-1x1-wrapper-cycle 12s infinite;
    z-index: 2;
  }

  .bt-1x1__logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22%;
  }

  /* 
    Animation Timing (12s total, 3 cycles of 4s each):
    Cycle 1 (0-4s):
      0-1.2s: Source (0-10%)
      1.2-1.8s: Shake & Transition to Target (10-15%)
      1.8-3.0s: Target 1 visible (15-25%)
      3.0-4.0s: Slow fade back to Source (25-33.33%)
  */

  .bt-1x1__logo--source {
    animation: bt-1x1-source-fade 12s infinite;
  }

  .bt-1x1__logo--target-1 {
    opacity: 0;
    animation: bt-1x1-target-fade-1 12s infinite;
  }

  .bt-1x1__logo--target-2 {
    opacity: 0;
    animation: bt-1x1-target-fade-2 12s infinite;
  }

  .bt-1x1__logo--target-3 {
    opacity: 0;
    animation: bt-1x1-target-fade-3 12s infinite;
  }

  @keyframes bt-1x1-source-fade {
    0%, 14% { opacity: 1; }
    14.01%, 25% { opacity: 0; }
    33.33%, 47.33% { opacity: 1; }
    47.34%, 58.33% { opacity: 0; }
    66.66%, 80.66% { opacity: 1; }
    80.67%, 91.66% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes bt-1x1-target-fade-1 {
    0%, 14% { opacity: 0; }
    14.01%, 25% { opacity: 1; }
    33.33%, 100% { opacity: 0; }
  }

  @keyframes bt-1x1-target-fade-2 {
    0%, 47.33% { opacity: 0; }
    47.34%, 58.33% { opacity: 1; }
    66.66%, 100% { opacity: 0; }
  }

  @keyframes bt-1x1-target-fade-3 {
    0%, 80.66% { opacity: 0; }
    80.67%, 91.66% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes bt-1x1-wrapper-cycle {
    /* Cycle 1 */
    0%, 10% { transform: scale(1) rotate(0deg); }
    11% { transform: scale(1) rotate(-6deg); }
    12% { transform: scale(1) rotate(6deg); }
    13% { transform: scale(1) rotate(-4deg); }
    13.33% { transform: scale(1) rotate(4deg); }
    14% { transform: scale(0) rotate(0deg); }
    15% { transform: scale(1.1) rotate(0deg); }
    16.5% { transform: scale(1) rotate(0deg); }
    25%, 33.33% { transform: scale(1) rotate(0deg); }

    /* Cycle 2 */
    33.33%, 43.33% { transform: scale(1) rotate(0deg); }
    44.33% { transform: scale(1) rotate(-6deg); }
    45.33% { transform: scale(1) rotate(6deg); }
    46.33% { transform: scale(1) rotate(-4deg); }
    46.66% { transform: scale(1) rotate(4deg); }
    47.33% { transform: scale(0) rotate(0deg); }
    48.33% { transform: scale(1.1) rotate(0deg); }
    49.83% { transform: scale(1) rotate(0deg); }
    58.33%, 66.66% { transform: scale(1) rotate(0deg); }

    /* Cycle 3 */
    66.66%, 76.66% { transform: scale(1) rotate(0deg); }
    77.66% { transform: scale(1) rotate(-6deg); }
    78.66% { transform: scale(1) rotate(6deg); }
    79.66% { transform: scale(1) rotate(-4deg); }
    80.00% { transform: scale(1) rotate(4deg); }
    80.66% { transform: scale(0) rotate(0deg); }
    81.66% { transform: scale(1.1) rotate(0deg); }
    83.16% { transform: scale(1) rotate(0deg); }
    91.66%, 100% { transform: scale(1) rotate(0deg); }
  }

  /* Dust Particles */
  .bt-1x1__dust-container {
    position: absolute;
    inset: -50%;
    pointer-events: none;
  }

  .bt-1x1__dust {
    position: absolute;
    width: 6px;
    height: 6px;
    background: #d0d7e5;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    opacity: 0;
  }

  /* Create 12 distinct dust particles with different trajectories */
  .bt-1x1__dust--1 { animation: bt-1x1-dust-1 12s infinite; }
  .bt-1x1__dust--2 { animation: bt-1x1-dust-2 12s infinite; }
  .bt-1x1__dust--3 { animation: bt-1x1-dust-3 12s infinite; }
  .bt-1x1__dust--4 { animation: bt-1x1-dust-4 12s infinite; }
  .bt-1x1__dust--5 { animation: bt-1x1-dust-5 12s infinite; }
  .bt-1x1__dust--6 { animation: bt-1x1-dust-6 12s infinite; }
  .bt-1x1__dust--7 { animation: bt-1x1-dust-7 12s infinite; }
  .bt-1x1__dust--8 { animation: bt-1x1-dust-8 12s infinite; }
  .bt-1x1__dust--9 { animation: bt-1x1-dust-9 12s infinite; }
  .bt-1x1__dust--10 { animation: bt-1x1-dust-10 12s infinite; }
  .bt-1x1__dust--11 { animation: bt-1x1-dust-11 12s infinite; }
  .bt-1x1__dust--12 { animation: bt-1x1-dust-12 12s infinite; }

  @keyframes bt-1x1-dust-1 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-60px, -80px) scale(0); } }
  @keyframes bt-1x1-dust-2 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.5); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(40px, -90px) scale(0); } }
  @keyframes bt-1x1-dust-3 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(0.8); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(80px, -50px) scale(0); } }
  @keyframes bt-1x1-dust-4 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.2); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(100px, 20px) scale(0); } }
  @keyframes bt-1x1-dust-5 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(60px, 80px) scale(0); } }
  @keyframes bt-1x1-dust-6 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.5); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-20px, 100px) scale(0); } }
  @keyframes bt-1x1-dust-7 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(0.8); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-80px, 60px) scale(0); } }
  @keyframes bt-1x1-dust-8 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.2); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-100px, -30px) scale(0); } }
  @keyframes bt-1x1-dust-9 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-30px, -70px) scale(0); } }
  @keyframes bt-1x1-dust-10 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.3); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(40px, 70px) scale(0); } }
  @keyframes bt-1x1-dust-11 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(0.9); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(70px, -30px) scale(0); } }
  @keyframes bt-1x1-dust-12 { 14%, 47.33%, 80.66% { opacity: 1; transform: translate(0, 0) scale(1.1); } 18%, 51.33%, 84.66% { opacity: 0; transform: translate(-70px, 30px) scale(0); } }

  @media (prefers-reduced-motion: reduce) {
    .bt-1x1__icon-wrapper,
    .bt-1x1__logo--source,
    .bt-1x1__logo--target-1,
    .bt-1x1__logo--target-2,
    .bt-1x1__logo--target-3,
    .bt-1x1__dust {
      animation: none !important;
    }
  }
</style>
