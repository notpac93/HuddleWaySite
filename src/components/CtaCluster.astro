---
import type { CallToAction } from '../data/site';

interface Props {
  primary: CallToAction;
  secondary?: CallToAction;
  className?: string;
}

const { primary, secondary, className = '' } = Astro.props;
---

<div class={`cta-cluster ${className}`.trim()}>
  {primary.prompt === 'app-store-choice' ? (
    <a class="button button--primary" href={primary.href} data-app-store-choice="true" aria-haspopup="dialog">{primary.label}</a>
  ) : (
    <a class="button button--primary" href={primary.href}>{primary.label}</a>
  )}
  {secondary && <a class="button button--secondary" href={secondary.href}>{secondary.label}</a>}
</div>
