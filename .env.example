# HuddleWay CRM browser configuration
#
# Local development defaults are provided by the source, but explicit values
# are recommended. Production builds default to the authoritative HuddleWay
# production endpoints and Firebase web app when these variables are absent.

PUBLIC_BACKEND_URL=http://localhost:3001

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_PROJECT_ID=huddleway-dev
PUBLIC_FIREBASE_AUTH_DOMAIN=huddleway-dev.firebaseapp.com
PUBLIC_FIREBASE_STORAGE_BUCKET=huddleway-dev.firebasestorage.app
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check uses a public reCAPTCHA Enterprise site key. Production
# builds fail closed unless App Check is configured.
PUBLIC_FIREBASE_APP_CHECK_ENABLED=false
PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Protected release workflows bind privacy-safe field performance samples to
# the exact deployed source. Leave blank for ordinary local development.
PUBLIC_WEBSITE_COMMIT=

# Emulator use is opt-in and must stay on a loopback host.
PUBLIC_FIREBASE_USE_EMULATORS=false
PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
PUBLIC_FIRESTORE_EMULATOR_PORT=8080
