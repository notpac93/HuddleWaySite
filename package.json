{
  "name": "huddleway-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "24.3.0",
    "npm": "11.5.2"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:stage-canary": "node scripts/build-crm-stage-canary.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:performance": "node scripts/check-crm-performance.mjs",
    "check:security": "node scripts/check-security-headers.mjs",
    "test": "npm run test:unit && npm run test:component",
    "test:build": "npm run build && npm run check:performance",
    "test:type": "npm run check -- --minimumSeverity error",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:component:watch": "vitest --config vitest.component.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:emulator": "RUN_FIREBASE_EMULATOR_TESTS=1 vitest run --config vitest.integration.config.ts tests/integration/firebase-emulator-seed.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run test:type && npm run test:unit && npm run test:component && npm run test:integration && npm run test:build && npm run test:e2e",
    "release:scope": "node scripts/release/crm-release.mjs scope",
    "release:preflight": "node scripts/release/crm-release.mjs preflight",
    "release:clean": "node scripts/release/crm-release.mjs clean",
    "release:quarantine": "node scripts/release/crm-release.mjs quarantine",
    "release:manifest": "node scripts/release/crm-release.mjs manifest",
    "release:verify": "node scripts/release/crm-release.mjs verify",
    "release:evidence:probe-media": "node scripts/release/crm-media-evidence.mjs",
    "release:deploy:inventory": "node scripts/release/crm-production-deploy.mjs inventory",
    "release:deploy:stage": "node scripts/release/crm-production-deploy.mjs stage",
    "release:deploy:probe-cdn": "node scripts/release/crm-production-deploy.mjs probe-cdn",
    "release:deploy:verify": "node scripts/release/crm-production-deploy.mjs verify-live",
    "release:deploy:rollback-receipt": "node scripts/release/crm-production-deploy.mjs record-rollback",
    "release:deploy:rollback-verify": "node scripts/release/crm-production-deploy.mjs verify-rollback-live",
    "release:audit": "npm audit --omit=dev --audit-level=high",
    "release:ci": "npm run release:preflight && npm run test:type && npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e && npm run release:audit && npm run release:clean && npm run build && npm run release:quarantine && npm run check:security && npm run check:performance && npm run release:manifest && npm run release:verify"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/sora": "^5.1.0",
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "firebase": "^12.16.0",
    "papaparse": "^5.5.4",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.0",
    "@types/papaparse": "^5.5.2",
    "firebase-admin": "^14.2.0",
    "jsdom": "^26.1.0",
    "terser": "5.44.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
